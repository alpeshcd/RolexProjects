# ============================================================
# Rolex Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Database -----------------------------------------------------------
DATABASE_URL=sqlite:///./rolex.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/rolex

# ---- Security -----------------------------------------------------------
SECRET_KEY=rolex-super-secret-jwt-key-2026-exchange-panel
# IMPORTANT: Change this before going live!

# ---- Market Data Source -------------------------------------------------
# Options:
#   mock    = generated fixtures (default, works offline, no API key needed)
#   mastan  = real Mastan exchange API (requires EXCHANGE_API_KEY + EXCHANGE_API_URL below)
#   betfair = Betfair Exchange API (requires BETFAIR_USERNAME + BETFAIR_PASSWORD + BETFAIR_APP_KEY)
EXCHANGE_PROVIDER=mock

# Only needed when EXCHANGE_PROVIDER=mastan
EXCHANGE_API_URL=https://api.mastan365.com
EXCHANGE_API_KEY=your_api_key_here

# Only needed when EXCHANGE_PROVIDER=betfair
BETFAIR_USERNAME=your_betfair_username
BETFAIR_PASSWORD=your_betfair_password
BETFAIR_APP_KEY=your_betfair_app_key
# Optional proxy if accessing from India / restricted country (e.g. http://proxy-server:port or socks5://...)
BETFAIR_PROXY=

# ---- Mastan Panel -------------------------------------------------------
# Default password for auto-created admin accounts on each portal.
# Change it immediately after first login!
EXCHANGE_DEMO_PASSWORD=master123

# ---- 2FA ----------------------------------------------------------------
# Demo OTP code accepted for all 2FA accounts (for testing only).
# Set to "" in production so only real authenticator codes work.
DEMO_OTP_CODE=123456

# ---- Live Casino (client's Operator API + wallet) -----------------------
# Which casino catalog the player site is served:
#   mock = built-in demo table list (default, works offline, no keys needed)
#   live = the client's Live Casino Platform (needs the CASINO_API_* values)
CASINO_PROVIDER=mock

# Inbound (us -> platform). Base URL + login the platform shared with us.
CASINO_API_URL=https://api.example.com/api/operator/e_w/v1
CASINO_API_USERNAME=operator_user
CASINO_API_PASSWORD=operator_password
CASINO_API_TIMEOUT=15

# Wallet model agreed with the platform: exposure | seamless.
# "exposure" holds the worst case and moves the balance once on settlement,
# which is how our own sports book already works.
CASINO_WALLET_MODEL=exposure

# Outbound (platform -> us). The platform MUST send this in the `Api-Key`
# header of every wallet call. Generate a long random string, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Until this is set the wallet endpoints decline everything, by design.
CASINO_OPERATOR_API_KEY=

# Where our wallet endpoints are mounted. Give the platform
#   https://<your-host>/casino/operator
# as the operator base URL; it then calls /accounts/exposure etc. under it.
CASINO_WALLET_BASE_PATH=/casino/operator

# Optional allowlist of the platform's source IPs (comma-separated).
# Leave empty to accept any source that has the API key.
CASINO_ALLOWED_IPS=

# Launch defaults sent with POST /launch-url
CASINO_RETURN_URL=https://your-site.com/casino
CASINO_CURRENCY=INR
CASINO_COUNTRY=IN
CASINO_LANG=en-US
CASINO_SESSION_HOURS=12
CASINO_GAMES_CACHE_HOURS=6

# How live tables are labelled, and the per-session bet limit we send
CASINO_PROVIDER_NAME=Live Casino
CASINO_MIN_BET=100
CASINO_MAX_BET=200000

# ---- File Uploads -------------------------------------------------------
# UPLOAD_DIR=/absolute/path/to/uploads
