{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rolex-backend",
      "runtimeExecutable": "backend/venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--reload",
        "--port",
        "8001",
        "--app-dir",
        "backend"
      ],
      "port": 8001
    },
    {
      "name": "rolex-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "mastan-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mastan-portal",
        "run",
        "dev"
      ],
      "port": 5174,
      "url": "http://mastan365.localhost:5174"
    },
    {
      "name": "user-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "user-site",
        "run",
        "dev"
      ],
      "port": 5175,
      "url": "http://mastan365.localhost:5175"
    }
  ]
}
